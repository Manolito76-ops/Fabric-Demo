	column Category =
			
			VAR _Name = Dim_SalesPricing[ProductName]
			RETURN
			SWITCH(
			    TRUE(),
			    CONTAINSSTRING(_Name, "E-"), "E-Bikes",
			    CONTAINSSTRING(_Name, "Pedelec"), "E-Bikes",
			    CONTAINSSTRING(_Name, "Gravel"), "Gravelbikes",
			    CONTAINSSTRING(_Name, "Mountainbike") || CONTAINSSTRING(_Name, "MTB"), "Mountainbikes",
			    CONTAINSSTRING(_Name, "Rennrad"), "Rennräder",
			    CONTAINSSTRING(_Name, "Kinderrad") || CONTAINSSTRING(_Name, "Jugendrad"), "Kinderräder",
			    "Trekking & City"
			)
		lineageTag: 9df7c0b9-c058-422f-b2f6-dd0b7d8f1aaf
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Dim_SalesPricing = entity
		mode: directLake
		source
			entityName: Dim_SalesPricing
			schemaName: stg
			expressionSource: 'DirectLake - wh_demo'

