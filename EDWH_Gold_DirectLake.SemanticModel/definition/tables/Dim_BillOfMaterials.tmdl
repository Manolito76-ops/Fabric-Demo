table Dim_BillOfMaterials
	lineageTag: 7f9b2c29-a98c-4f82-aed1-5765424e0d70
	sourceLineageTag: [stg].[Dim_BillOfMaterials]

	measure MaterialCost_per_Unit =
			
			SUMX(
			    Dim_BillOfMaterials,
			    Dim_BillOfMaterials[QuantityPerUnit] * RELATED(Dim_PurchasePricing[StandardPurchasePrice])
			)
		lineageTag: 2d5275b3-a979-4a15-b466-b16db4a165b4

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure COGS_BOM =
			
			SUMX(
			    VALUES(FactOrders[ProductID]),
			    SUM(FactOrders[TotalQuantity]) * [MaterialCost_per_Unit]
			)
		lineageTag: e46c98af-bfff-46b1-9dcb-5c0006bdb95c

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

